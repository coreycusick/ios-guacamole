+					    glitches, k, pending[k], pon, vup, vdn);
+				}
+				pending[k] = -1;
+			} else if (pending[k] != now[k]) {
+				pending[k] = now[k];    /* first read of a change: wait for the next one */
+			} else {
+				pending[k] = -1;
