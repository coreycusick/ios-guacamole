+static void
+prof_add_chain(struct prof_chain *t, const uint64_t *f, uint32_t *dropped)
+{
+	uint64_t k[PROF_CHAIN], h64 = 0;
+	for (int i = 0; i < PROF_CHAIN; i++) {
+		k[i] = (i == 0 || k[i - 1]) ? (f[i] & PROF_VA_MASK) : 0;
+		h64 = (h64 ^ k[i]) * 0x9E3779B97F4A7C15ull;
+	}
+	uint32_t h = (uint32_t)(h64 >> 51);
+	for (uint32_t i = 0; i < PROF_SLOTS; i++) {
+		struct prof_chain *s = &t[(h + i) & (PROF_SLOTS - 1)];
+		if (s->n && memcmp(s->a, k, sizeof(k)) == 0) {
+			s->n++;
+			return;
+		}
+		if (s->n == 0) {
+			memcpy(s->a, k, sizeof(k));
+			s->n = 1;
+			return;
+		}
+	}
+	(*dropped)++;
+}
+
+static int
+prof_top_chains(struct prof_chain *t, char *s, int cap)
+{
+	int n = 0;
+	for (int k = 0; k < PROF_CHAIN_TOP && n < cap - 160; k++) {
+		struct prof_chain *best = NULL;
+		for (uint32_t i = 0; i < PROF_SLOTS; i++) {
+			if (t[i].n && (best == NULL || t[i].n > best->n)) {
+				best = &t[i];
+			}
+		}
+		if (best == NULL) {
+			break;
+		}
+		n += snprintf(s + n, cap - n, "call %u", best->n);
+		for (int i = 0; i < PROF_CHAIN && n < cap - 24; i++) {
+			n += snprintf(s + n, cap - n, " 0x%llx", best->a[i]);
+		}
+		n += snprintf(s + n, cap - n, "\n");
+		best->n = 0;
+	}
+	return n;
+}
