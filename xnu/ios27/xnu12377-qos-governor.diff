+/*
+ * 2026-11-26 governor. Until now every domain stayed on its top row from boot (sweetcpufreq=3): flat out, hot, and the
+ * LMh limiter throttling under sustained load. Now, 60 s after boot (the boot itself stays at the top), every 20 ms:
+ * a domain's load is its busiest CPU's busy share since the last sample (recount idle time, osfmk/kern/processor.c
+ * sweet_cpu_idle_mach); it gets the lowest row that would run that load at <= 80 % busy. Up at once, down after
+ * 100 ms of less. A touch (sweet_touch.c) holds the A76 domains on their top row for 300 ms. sysctl
+ * kern.sweet_cpufreq_gov=0: top rows again (the old behaviour); kern.sweet_cpufreq_stats: rows, loads, counts.
+ */
+#define GOV_DOMAINS             3
+#define GOV_PERIOD_MS           20
+#define GOV_TARGET_PCT          80
+#define GOV_DOWN_SAMPLES        5
+#define GOV_BOOST_MS            300
+#define GOV_START_S             60
+#define GOV_CPUS                8
