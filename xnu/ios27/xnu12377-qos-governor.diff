+static bool gov_domain_on[GOV_DOMAINS], gov_running;
+static int sweet_cpufreq_gov = 1;
+static uint64_t gov_boost_until, gov_boosts, gov_changes;
+
+/* touch: the A76 domains on their top row for the next GOV_BOOST_MS (any context: two stores) */
+void
+sweet_cpufreq_boost(void)
+{
+	uint64_t now = mach_absolute_time(), until;
+	clock_interval_to_deadline(GOV_BOOST_MS, NSEC_PER_MSEC, &until);
+	if (now >= gov_boost_until) {
+		gov_boosts++;
+	}
+	gov_boost_until = until;
+}
+
+static void
+gov_set(unsigned d, uint32_t row)
+{
+	if (row != gov_row[d]) {
+		osm_wr(gov_b[d], OSM_PERF_STATE, row);
+		gov_row[d] = row;
+		gov_changes++;
+	}
+}
+
+static void
+gov_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline((event_t)&gov_b, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gov_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t idle0[GOV_CPUS], idle1[GOV_CPUS], t0, t1;
+	unsigned down[GOV_DOMAINS] = { 0 };
+	gov_wait_ms(GOV_START_S * 1000u);
+	printf("SWEET CPUFREQ: governor on (kern.sweet_cpufreq_gov=0 for top rows)\n");
+	sweet_cpu_idle_mach(idle0, GOV_CPUS);
+	t0 = mach_absolute_time();
+	for (;;) {
+		gov_wait_ms(GOV_PERIOD_MS);
+		sweet_cpu_idle_mach(idle1, GOV_CPUS);
+		t1 = mach_absolute_time();
+		uint64_t elapsed = t1 - t0;
+		bool boost = t1 < gov_boost_until;
+		for (unsigned d = 0; d < GOV_DOMAINS; d++) {
+			if (!gov_domain_on[d]) {
+				continue;
+			}
+			uint32_t top = gov_rows[d] - 1;
+			if (!sweet_cpufreq_gov) {
+				down[d] = 0;
+				gov_set(d, top);
+				continue;
+			}
+			uint32_t load = 0;
+			for (unsigned c = sweet_osm[d].first_cpu; c <= sweet_osm[d].last_cpu && c < GOV_CPUS; c++) {
+				uint64_t di = idle1[c] - idle0[c];
+				uint32_t busy = elapsed == 0 ? 100 : 100 - (uint32_t)MIN(100, di * 100 / elapsed);
+				load = MAX(load, busy);
+			}
+			gov_load[d] = load;
+			uint32_t want = top;
+			if (!(boost && sweet_osm[d].big)) {
+				uint64_t need = (uint64_t)gov_khz[d][gov_row[d]] * load / GOV_TARGET_PCT;
+				want = 0;
+				while (want < top && gov_khz[d][want] < need) {
+					want++;
+				}
+			}
+			if (want >= gov_row[d]) {
+				down[d] = 0;
+				gov_set(d, want);
+			} else if (++down[d] >= GOV_DOWN_SAMPLES) {
+				down[d] = 0;
+				gov_set(d, want);
+			}
