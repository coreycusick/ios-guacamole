+/*
+ * CPU stand-in for Apple's AppleM2ScalerCSCDriver / IOSurfaceAccelerator.
+ *
+ * IOSurfaceAccelerator.framework opens the service with type 0 and sends
+ * selector 1 via IOConnectCallStructMethod. The ordinary request contains
+ * source/destination IOSurface IDs at byte offsets 0 and 4; the request is
+ * 0x58 bytes. This fallback intentionally implements the common full-surface
+ * copy/scale path. It supports packed 32-bit BGRA/RGBA and 420f/420v input
+ * converted to packed output. Unknown options/rect encodings are logged and
+ * rejected instead of silently corrupting a surface.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+#include "SweetSurface.h"
+
+class AppleM2ScalerCSCDriver : public IOService {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+    setProperty(kIOUserClientClassKey, "AppleM2ScalerCSCDriverUserClient");
+    setProperty("IONameMatched", "AppleM2ScalerCSCDriver");
+    registerService();
+    IOLog("SWEET SCALER: AppleM2ScalerCSCDriver registered (CPU fallback)\n");
+    return true;
+}
+
+class AppleM2ScalerCSCDriverUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriverUserClient);
+public:
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+        IOExternalMethodDispatch *dispatch, OSObject *target,
+        void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriverUserClient, IOUserClient);
+
+static uint32_t sweet_scaler_log_count;
+static inline uint32_t
+sweet_scaler_u32(const uint8_t *p)
+{
+    uint32_t v;
+    bcopy(p, &v, sizeof(v));
+    return v;
+}
+
+static inline bool
+sweet_scaler_fourcc(uint32_t f, char a, char b, char c, char d)
+{
+    return f == (((uint32_t)(uint8_t)a << 24) | ((uint32_t)(uint8_t)b << 16) |
+        ((uint32_t)(uint8_t)c << 8) | (uint32_t)(uint8_t)d);
+}
+
+static uint8_t
+sweet_scaler_clamp(int v)
+{
+    return (uint8_t)(v < 0 ? 0 : (v > 255 ? 255 : v));
+}
+
+static bool
+sweet_scaler_convert(SweetSurface *src, SweetSurface *dst)
+{
+    if (src == NULL || dst == NULL || !src->width || !src->height ||
+        !dst->width || !dst->height || src->width > 16384 || src->height > 16384 ||
+        dst->width > 16384 || dst->height > 16384) return false;
+    uintptr_t sb = src->kernelAddress(), db = dst->kernelAddress();
+    if (!sb || !db) return false;
+    bool srcBGRA = sweet_scaler_fourcc(src->pixelFormat, 'B','G','R','A');
+    bool srcRGBA = sweet_scaler_fourcc(src->pixelFormat, 'R','G','B','A');
+    bool src420f = sweet_scaler_fourcc(src->pixelFormat, '4','2','0','f');
+    bool src420v = sweet_scaler_fourcc(src->pixelFormat, '4','2','0','v');
+    bool dstBGRA = sweet_scaler_fourcc(dst->pixelFormat, 'B','G','R','A');
+    bool dstRGBA = sweet_scaler_fourcc(dst->pixelFormat, 'R','G','B','A');
+    if ((!srcBGRA && !srcRGBA && !src420f && !src420v) || (!dstBGRA && !dstRGBA)) return false;
+
+    uint32_t sw = src->width, sh = src->height, dw = dst->width, dh = dst->height;
+    uint32_t sp = src->bytesPerRow, dp = dst->bytesPerRow;
+    if (srcBGRA || srcRGBA) {
+        if (sp < sw * 4 || dp < dw * 4) return false;
+    } else {
+        if (src->planeCount < 2 || src->planes[0].bytesPerRow < sw ||
+            src->planes[1].bytesPerRow < ((sw + 1) & ~1u)) return false;
+    }
+    uint8_t *s = (uint8_t *)sb + src->offset;
+    uint8_t *d = (uint8_t *)db + dst->offset;
+    uint8_t *yplane = NULL, *uvplane = NULL;
+    uint32_t yp = 0, uvp = 0;
+    if (src420f || src420v) {
+        yplane = (uint8_t *)sb + src->planes[0].offset;
+        uvplane = (uint8_t *)sb + src->planes[1].offset;
+        yp = src->planes[0].bytesPerRow;
+        uvp = src->planes[1].bytesPerRow;
+    }
+    /* Default API operation scales the full source to the full destination.
+     * Rectangles are retained in the public 0x58 request but CA's snapshot
+     * TransferSurface path supplies no rectangles; TransformSurface rectangle
+     * encoding differs by API generation and is logged until field evidence is
+     * available. */
+    for (uint32_t y = 0; y < dh; y++) {
+        uint32_t sy = (uint64_t)y * sh / dh;
+        for (uint32_t x = 0; x < dw; x++) {
+            uint32_t sx = (uint64_t)x * sw / dw;
+            uint8_t r, g, b, a = 255;
+            if (srcBGRA || srcRGBA) {
+                const uint8_t *p = s + (uint64_t)sy * sp + (uint64_t)sx * 4;
+                if (srcBGRA) { b=p[0]; g=p[1]; r=p[2]; a=p[3]; }
+                else { r=p[0]; g=p[1]; b=p[2]; a=p[3]; }
+            } else {
+                int yy = yplane[(uint64_t)sy * yp + sx];
+                const uint8_t *uv = uvplane + (uint64_t)(sy / 2) * uvp + (sx & ~1u);
+                int u = uv[0], v = uv[1];
+                if (src420v) yy = (yy - 16) * 255 / 219;
+                int c = yy, d1 = u - 128, e1 = v - 128;
+                /* BT.601 default; common video surface on this port. */
+                r = sweet_scaler_clamp((298*c + 409*e1 + 128) >> 8);
+                g = sweet_scaler_clamp((298*c - 100*d1 - 208*e1 + 128) >> 8);
+                b = sweet_scaler_clamp((298*c + 516*d1 + 128) >> 8);
+            }
+            uint8_t *q = d + (uint64_t)y * dp + (uint64_t)x * 4;
+            if (dstBGRA) { q[0]=b; q[1]=g; q[2]=r; q[3]=a; }
+            else { q[0]=r; q[1]=g; q[2]=b; q[3]=a; }
+        }
+    }
+    return true;
+}
+
+IOReturn
+AppleM2ScalerCSCDriverUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+    if (selector != 1 || args == NULL || args->structureInput == NULL ||
+        args->structureInputSize < 8) return kIOReturnBadArgument;
+    const uint8_t *in = (const uint8_t *)args->structureInput;
+    uint32_t srcID = sweet_scaler_u32(in + 0);
+    uint32_t dstID = sweet_scaler_u32(in + 4);
+    SweetSurface *src = sweet_surface_copy(srcID);
+    SweetSurface *dst = sweet_surface_copy(dstID);
+    bool ok = sweet_scaler_convert(src, dst);
+    if (sweet_scaler_log_count++ < 32) {
+        char name[32]; proc_selfname(name, sizeof(name));
+        IOLog("SWEET SCALER: %s selector=%u src=%u dst=%u size=%u srcfmt=%08x %ux%u dstfmt=%08x %ux%u rect0=%08x,%08x,%08x,%08x -> %s\n",
+            name, selector, srcID, dstID, (uint32_t)args->structureInputSize,
+            src ? src->pixelFormat : 0, src ? src->width : 0, src ? src->height : 0,
+            dst ? dst->pixelFormat : 0, dst ? dst->width : 0, dst ? dst->height : 0,
+            args->structureInputSize >= 24 ? sweet_scaler_u32(in+8) : 0,
+            args->structureInputSize >= 24 ? sweet_scaler_u32(in+12) : 0,
+            args->structureInputSize >= 24 ? sweet_scaler_u32(in+16) : 0,
+            args->structureInputSize >= 24 ? sweet_scaler_u32(in+20) : 0,
+            ok ? "copied" : "unsupported");
+    }
+    if (args->structureOutput != NULL && args->structureOutputSize)
+        bzero(args->structureOutput, args->structureOutputSize);
+    OSSafeReleaseNULL(src);
+    OSSafeReleaseNULL(dst);
+    return ok ? kIOReturnSuccess : kIOReturnUnsupported;
+}
+#endif /* SWEET */
