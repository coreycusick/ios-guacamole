 	} else {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * 0263: SWEET does not enforce code signing (no Image4 trust, AMFI
+		 * built in). A page that fails its hash still maps, as on Apple's
+		 * non-enforcing path, but the process keeps CS_VALID: csops()
+		 * entitlement queries (CS_OPS_ENTITLEMENTS_BLOB / _DER_) return
+		 * EINVAL for a process without CS_VALID, so securityd saw no
+		 * application-identifier / keychain-access-groups and refused every
