+		 * The first 32 such pages per boot are logged here.
+		 */
+		static uint32_t sweet_cs_kept;
+		if ((flags & CS_VALID) && !(flags & CS_HARD)) {
+			proc_csflags_update(p, flags);
+			proc_unlock(p);
+			if (sweet_cs_kept++ < 32) {
+				printf("CODE SIGNING: cs_invalid_page(0x%llx): p=%d[%s] status 0x%x, "
+				    "allowing page, SWEET keeps VALID\n",
+				    vaddr, proc_getpid(p), p->p_comm, (unsigned int)flags);
+			}
+			if (cs_killed) {
+				*cs_killed = FALSE;
+			}
+			return 0;
+		}
+#endif
