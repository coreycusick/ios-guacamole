--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -980,6 +980,55 @@
 .endmacro
 
 el0_synchronous_vector_64_long:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * 2026-11-27 (Claude): mach_absolute_time / mach_continuous_time without the full exception. With the 24 MHz
+	 * timebase (sweet_tb24, pexpert/arm/pe_identify_machine.c) EL0 cannot scale the counter itself, so every user
+	 * clock read is a mach trap (svc #0x80, x16 = -3 / -4): the whole user state saved and restored, ASTs, kdebug.
+	 * That was 12-19% of backboardd's samples while Control Center animated. Here the answer is made at the vector
+	 * and returned with eret: floor(CNTVCT * 5 / 4) as ml_get_hwclock() makes it, plus mach_absolutetime_asleep for
+	 * the continuous clock. Only while rtclock_base_abstime is 0 (cpu_timebase_init clears sweet_fast_abstime
+	 * otherwise: after a wake from sleep the kernel adds an offset). x0 is the answer; x1, the flags (SPSR) and
+	 * everything else come back unchanged; x16 is the trap number the stub set. sysctl kern.sweet_fast_abstime=0
+	 * sends these traps the long way again.
+	 */
+	stp		x0, x1, [sp, #-16]!
+	mrs		x0, ESR_EL1
+	lsr		w1, w0, #26
+	cmp		w1, #0x15					// ESR_EC_SVC_64
+	b.ne		Lsweet_fast_time_out
+	and		w1, w0, #0xffff
+	cmp		w1, #0x80					// svc #0x80
+	b.ne		Lsweet_fast_time_out
+	cmn		x16, #3						// MACH_ARM_TRAP_ABSTIME
+	b.eq		Lsweet_fast_time_ok
+	cmn		x16, #4						// MACH_ARM_TRAP_CONTTIME
+	b.ne		Lsweet_fast_time_out
+Lsweet_fast_time_ok:
+	adrp		x0, EXT(sweet_fast_abstime)@page
+	add		x0, x0, EXT(sweet_fast_abstime)@pageoff
+	ldr		w0, [x0]
+	cbz		w0, Lsweet_fast_time_out
+	adrp		x0, EXT(sweet_tb24)@page
+	add		x0, x0, EXT(sweet_tb24)@pageoff
+	ldr		w0, [x0]
+	cbz		w0, Lsweet_fast_time_out
+	isb							// non-speculative, as nonspeculative_timebase()
+	mrs		x0, CNTVCT_EL0
+	add		x0, x0, x0, lsr #2				// floor(hw * 5 / 4)
+	cmn		x16, #4
+	b.ne		Lsweet_fast_time_ret
+	adrp		x1, EXT(mach_absolutetime_asleep)@page
+	add		x1, x1, EXT(mach_absolutetime_asleep)@pageoff
+	ldr		x1, [x1]
+	add		x0, x0, x1
+Lsweet_fast_time_ret:
+	ldr		x1, [sp, #8]
+	add		sp, sp, #16
+	eret
+Lsweet_fast_time_out:
+	ldp		x0, x1, [sp], #16
+#endif
 	EL0_64_VECTOR	sync
 	EL0_64_VECTOR_SWITCH_TO_KERN_STACK
 	adrp	x1, EXT(fleh_synchronous)@page			// Load address for fleh
