 int sweet_tb24 = 0;
+/* 1 = the EL0 sync vector answers the clock traps itself (osfmk/arm64/locore.s); sysctl kern.sweet_fast_abstime */
+int sweet_fast_abstime = 1;
 
 static inline uint64_t
 sweet_tb_up(uint64_t hw)
