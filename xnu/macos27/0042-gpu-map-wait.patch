 /* On-demand L2/L3 tables for CB1, carved from contiguous pages. */
 static uint64_t be_l3_pa[GVA_USER_END >> 21];      /* 0 = none; one L3 covers 2 MB */
 static vm_offset_t be_l3_kva[GVA_USER_END >> 21];  /* kernel VA of that L3 page */
+/*
+ * 2026-11-27 (Claude): the L3 tables written since the last flush (one bit per 2 MB slot). redwood_gpu_mapped() cleaned
+ * every L3 table that exists (a loop over 32768 slots and 4 KB of cache clean per table, after each 1024-page piece of
+ * every BoMap); tables are never freed, so the cost grew with every address ever mapped. Turnip's BoMap was 3.8% of
+ * backboardd in a Control Center profile. Now only the tables written are cleaned.
+ */
+static uint64_t be_l3_dirty[(GVA_USER_END >> 21) / 64];
+static unsigned be_l3_dirty_lo = ~0u, be_l3_dirty_hi;
+
+static void
+be_l3_mark(uint64_t va)
+{
+	unsigned slot = (unsigned)(va >> 21);
+	be_l3_dirty[slot / 64] |= 1ull << (slot % 64);
+	if (slot < be_l3_dirty_lo) {
+		be_l3_dirty_lo = slot;
+	}
+	if (slot > be_l3_dirty_hi) {
+		be_l3_dirty_hi = slot;
+	}
+}
+
+/* clean the written L3 tables to memory (the SMMU's walks do not snoop) */
+static void
+be_l3_clean(void)
+{
+	if (be_l3_dirty_lo > be_l3_dirty_hi) {
+		return;
+	}
+	for (unsigned w = be_l3_dirty_lo / 64; w <= be_l3_dirty_hi / 64; w++) {
+		uint64_t bits = be_l3_dirty[w];
+		be_l3_dirty[w] = 0;
+		while (bits) {
+			unsigned s = w * 64 + (unsigned)__builtin_ctzll(bits);
+			bits &= bits - 1;
+			if (be_l3_pa[s]) {
+				flush_dcache64((addr64_t)be_l3_kva[s], 0x1000u, FALSE);
+			}
+		}
+	}
+	be_l3_dirty_lo = ~0u;
+	be_l3_dirty_hi = 0;
+}
