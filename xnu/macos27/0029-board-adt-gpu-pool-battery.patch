+/* ADT /sweet-gpu pool-ranges into gpu_pool_ranges; false (nothing changed) if absent or unusable */
+static bool
+gpu_pool_from_adt(void)
+{
+	DTEntry node;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "pool-ranges", &prop, &size) != kSuccess) {
+		return false;
+	}
+	unsigned n = size / 16;
+	if (size == 0 || size % 16 || n > GPU_POOL_MAX_RANGES) {
+		printf("SWEET GPU: /sweet-gpu pool-ranges has %u bytes: ignored\n", size);
+		return false;
+	}
+	struct gpu_pool_range r[GPU_POOL_MAX_RANGES];
+	uint64_t total = 0;
+	for (unsigned i = 0; i < n; i++) {
+		memcpy(&r[i].start, (const uint8_t *)prop + 16 * i, 8);
+		memcpy(&r[i].end, (const uint8_t *)prop + 16 * i + 8, 8);
+		if (r[i].end <= r[i].start || (r[i].start | r[i].end) % GPU_POOL_CHUNK ||
+		    r[i].end - r[i].start > GPU_POOL_MAX_BYTES - total) {
+			printf("SWEET GPU: /sweet-gpu pool-ranges entry %u %#llx-%#llx unusable: ignored\n", i,
+			    (unsigned long long)r[i].start, (unsigned long long)r[i].end);
+			return false;
+		}
+		total += r[i].end - r[i].start;
+	}
+	memcpy(gpu_pool_ranges, r, n * sizeof(r[0]));
+	gpu_pool_nranges = n;
+	return true;
+}
