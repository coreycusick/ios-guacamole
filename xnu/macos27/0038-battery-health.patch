+/*
+ * 2026-11-26: battery health from the BQ27541 (bsd/dev/sweet_gauge.c): its learned full charge capacity, its
+ * design capacity and its cycle count, used when plausible; a failed read keeps the last good values.
+ */
+void
+SweetBattery::pollGauge(void)
+{
+	struct sweet_gauge g = {};
+	int err = sweet_gauge_read(&g);
+	bool ok = !err && g.design >= 1000 && g.design <= 10000 && g.fcc >= g.design / 4u &&
+	    g.fcc <= g.design + g.design / 5u && g.cycles < 10000;
+	if (ok && (!fGaugeOK || g.fcc != fGaugeFcc || g.cycles != fCycles || fPolls % 120 == 2)) {
+		IOLog("SWEET BATTERY: BQ27541: full charge %u of %u mAh (%u%%), %u cycles, gauge %u%% %umV %dmA\n",
+		    g.fcc, g.design, (g.fcc * 100u + g.design / 2u) / g.design, g.cycles, g.soc, g.mv, g.ma);
+	} else if (!err && !ok) {
+		IOLog("SWEET BATTERY: BQ27541 values not plausible: fcc %u design %u cycles %u; not used\n",
+		    g.fcc, g.design, g.cycles);
+	}
+	/*
+	 * 2026-11-27: powerd's battery health also wants the cell resistance: BatteryData "WeightedRa" (a battery under
+	 * powerd's threshold, 492 here, is normal; above it, service; missing: health "not determined", which Settings
+	 * shows as an endless spinner) and Ra00-Ra14. The BQ27411's own R_a table (TI units, about milliohms) is used;
+	 * WeightedRa is the plain mean of Ra0-Ra12 (the last two only matter near empty). Apple's exact weighting is
+	 * not public, so this is an approximation of the same quantity, from the real cell.
+	 */
+	if (!err && g.ra_ok && !fRaOK) {
+		unsigned sum = 0;
+		bool sane = true;
+		for (unsigned i = 0; i < 15; ++i) {
+			fRa[i] = g.ra[i];
+			sane = sane && g.ra[i] > 0 && g.ra[i] < 5000;
+			if (i < 13) {
+				sum += g.ra[i];
+			}
+		}
+		if (sane) {
+			fWeightedRa = (sum + 6u) / 13u;
+			fRaOK = true;
+			IOLog("SWEET BATTERY: BQ27411 R_a table read, WeightedRa %u\n", fWeightedRa);
+		}
+	}
+	if (ok) {
+		fGaugeFcc = g.fcc;
+		fGaugeDesign = g.design;
+		fCycles = g.cycles;
