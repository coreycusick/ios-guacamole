+	uint8_t mode = 0, cfg = 0, cl = 0;
+	if (sweet_spmi_read(2, 0x1544, &mode) || sweet_spmi_read(2, 0x1153, &cfg) || sweet_spmi_read(2, 0x1152, &cl)) {
+		TC_LOG("SWEET TYPEC: PM8150B Type-C registers unreadable; off\n");
+		return;
+	}
+	TC_LOG("SWEET TYPEC: mode cfg %#x otg cfg %#x otg limit %#x (sweetotg=%d)\n", mode, cfg, cl, otg);
+	if (!otg) {
+		return;
+	}
+	int we = sweet_spmi_write(2, 0x1140, 0);                  /* VBUS off until a sink is seen */
+	int we2 = sweet_spmi_write(2, 0x1153, (uint8_t)(cfg & ~2u));   /* VBUS under software control */
+	int we3 = sweet_spmi_write(2, 0x1152, (uint8_t)((cl & ~7u) | 2u));  /* 1.5 A */
+	if (we || we2 || we3) {
+		TC_LOG("SWEET TYPEC: OTG register writes refused (%d %d %d)\n", we, we2, we3);
+	}
+	uint8_t now = 0;
+	for (unsigned i = 0; i < 10; ++i) {                       /* OnePlus retries this write */
+		(void)sweet_spmi_write(2, 0x1544, (uint8_t)((mode & ~0x1fu) | 0x10u));   /* EN_TRY_SNK */
+		IOSleep(30);
+		if (!sweet_spmi_read(2, 0x1544, &now) && (now & 0x1fu) == 0x10u) {
+			fOtg = true;
+			break;
+		}
+	}
+	TC_LOG("SWEET TYPEC: dual role (try.SNK) %s, mode cfg %#x\n", fOtg ? "on" : "FAILED", now);
+}
+
+void
+SweetBattery::checkTypec(void)
+{
+	uint8_t sm = 0, misc = 0, src = 0;
+	if (sweet_spmi_read(2, 0x1509, &sm) || sweet_spmi_read(2, 0x150b, &misc) || sweet_spmi_read(2, 0x1508, &src)) {
+		return;
+	}
+	bool attached = (sm & 0x20u) != 0, source = attached && (misc & 0x40u);
+	bool sink = source && (src & 0x0cu) != 0;                 /* Rd-open or Rd-Ra: a USB device */
+	bool vbusError = (misc & 0x10u) != 0;
+	bool want = sink && !vbusError;
+	if (sm != fTypecSeen[0] || misc != fTypecSeen[1] || src != fTypecSeen[2]) {
+		TC_LOG("SWEET TYPEC: state %#x misc %#x src %#x: %s%s%s\n", sm, misc, src,
+		    !attached ? "detached" : source ? (sink ? "device attached (phone is host)" : "source role, no device") :
+		    "phone is a device (charger / computer)", (misc & 2u) ? ", CC2" : attached ? ", CC1" : "",
+		    vbusError ? ", VBUS ERROR" : "");
+		fTypecSeen[0] = sm;
+		fTypecSeen[1] = misc;
+		fTypecSeen[2] = src;
+	}
+	if (want != fOtgOn) {
+		uint8_t cmd = 0;
+		(void)sweet_spmi_read(2, 0x1140, &cmd);
+		(void)sweet_spmi_write(2, 0x1140, (uint8_t)(want ? (cmd | 1u) : (cmd & ~1u)));
+		fOtgOn = want;
+		TC_LOG("SWEET TYPEC: 5 V VBUS %s%s\n", want ? "on" : "off", vbusError ? " (VBUS error)" : "");
+	}
+}
